--- a/termenv_haiku.go	1970-01-01 00:00:00.000000000 +0000
+++ b/termenv_haiku.go	2026-11-22 06:00:27.045865004 +0000
@@ -0,0 +1,20 @@
+//go:build haiku
+// +build haiku
+
+package termenv
+
+import "golang.org/x/sys/unix"
+
+// Haiku names the termios ioctls TCGETA/TCSETA; they take a struct termios.
+const (
+	tcgetattr = unix.TCGETA
+	tcsetattr = unix.TCSETA
+)
+
+func isForeground(fd int) bool {
+	pgrp, err := unix.IoctlGetInt(fd, unix.TIOCGPGRP)
+	if err != nil {
+		return false
+	}
+	return pgrp == unix.Getpgrp()
+}
