diff -ruN a/pty_haiku.go b/pty_haiku.go
--- a/pty_haiku.go	1970-01-01 00:00:00.000000000 +0000
+++ b/pty_haiku.go	2026-11-22 11:03:15.436727013 +0000
@@ -0,0 +1,46 @@
+//go:build haiku
+
+package pty
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// From Haiku's headers/private/drivers/tty.h, as libroot's posix_openpt,
+// grantpt and ptsname use them.
+const (
+	ioctlGetTTYIndex = unix.TCGETA + 32 // param is int32*
+	ioctlGrantTTY    = unix.TCGETA + 33 // no param
+)
+
+func open() (pty, tty *os.File, err error) {
+	p, err := os.OpenFile("/dev/ptmx", os.O_RDWR, 0)
+	if err != nil {
+		return nil, nil, err
+	}
+	// In case of error after this point, make sure we close the ptmx fd.
+	defer func() {
+		if err != nil {
+			_ = p.Close() // Best effort.
+		}
+	}()
+
+	index, err := unix.IoctlGetInt(int(p.Fd()), ioctlGetTTYIndex)
+	if err != nil {
+		return nil, nil, err
+	}
+	if err := unix.IoctlSetInt(int(p.Fd()), ioctlGrantTTY, 0); err != nil {
+		return nil, nil, err
+	}
+
+	sname := fmt.Sprintf("/dev/tt/%c%x", rune('p'+index/16), index%16)
+	t, err := os.OpenFile(sname, os.O_RDWR|syscall.O_NOCTTY, 0)
+	if err != nil {
+		return nil, nil, err
+	}
+	return p, t, nil
+}
