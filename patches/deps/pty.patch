--- a/ioctl_haiku.go	1970-01-01 00:00:00.000000000 +0000
+++ b/ioctl_haiku.go	2026-11-22 11:03:15.424727013 +0000
@@ -0,0 +1,32 @@
+//go:build haiku
+
+package pty
+
+import (
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	TIOCGWINSZ = unix.TIOCGWINSZ
+	TIOCSWINSZ = unix.TIOCSWINSZ
+)
+
+// Haiku has no ioctl system call the syscall package can make; go through
+// libroot with x/sys. Only the window size requests are used here.
+func ioctlInner(fd, cmd, ptr uintptr) error {
+	switch cmd {
+	case TIOCSWINSZ:
+		return unix.IoctlSetWinsize(int(fd), uint(cmd), (*unix.Winsize)(unsafe.Pointer(ptr)))
+	case TIOCGWINSZ:
+		ws, err := unix.IoctlGetWinsize(int(fd), uint(cmd))
+		if err != nil {
+			return err
+		}
+		*(*unix.Winsize)(unsafe.Pointer(ptr)) = *ws
+		return nil
+	}
+	return syscall.ENOTSUP
+}
