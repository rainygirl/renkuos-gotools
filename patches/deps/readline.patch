diff -ruN a/term_haiku.go b/term_haiku.go
--- a/term_haiku.go	1970-01-01 00:00:00.000000000 +0000
+++ b/term_haiku.go	2026-11-22 10:28:23.727819009 +0000
@@ -0,0 +1,30 @@
+// +build haiku
+
+package readline
+
+import "golang.org/x/sys/unix"
+
+// GetSize returns the dimensions of the given terminal.
+func GetSize(fd int) (int, int, error) {
+	ws, err := unix.IoctlGetWinsize(fd, unix.TIOCGWINSZ)
+	if err != nil {
+		return 0, 0, err
+	}
+	return int(ws.Col), int(ws.Row), nil
+}
+
+type Termios unix.Termios
+
+// Haiku names the termios ioctls TCGETA and TCSETA; they take a struct
+// termios.
+func getTermios(fd int) (*Termios, error) {
+	termios, err := unix.IoctlGetTermios(fd, unix.TCGETA)
+	if err != nil {
+		return nil, err
+	}
+	return (*Termios)(termios), nil
+}
+
+func setTermios(fd int, termios *Termios) error {
+	return unix.IoctlSetTermios(fd, unix.TCSETAF, (*unix.Termios)(termios))
+}
