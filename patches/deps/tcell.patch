diff -ruN a/tty/nonblock_haiku.go b/tty/nonblock_haiku.go
--- a/tty/nonblock_haiku.go	1970-01-01 00:00:00.000000000 +0000
+++ b/tty/nonblock_haiku.go	2026-11-22 06:41:17.778249721 +0000
@@ -0,0 +1,28 @@
+//go:build haiku
+
+package tty
+
+import (
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// Haiku names the termios ioctls TCGETA/TCSETAW; they take a struct termios.
+func tcSetBufParams(fd int, vMin uint8, vTime uint8) error {
+	_ = syscall.SetNonblock(fd, true)
+	tio, err := unix.IoctlGetTermios(fd, unix.TCGETA)
+	if err != nil {
+		return err
+	}
+	tio.Cc[unix.VMIN] = vMin
+	tio.Cc[unix.VTIME] = vTime
+	return unix.IoctlSetTermios(fd, unix.TCSETAW, tio)
+}
+
+// Flushing is best effort: the arm64 kernel of RenkuOS answers TCFLSH with
+// an error, and a failed flush is not a reason to refuse to start.
+func tcFlushInput(fd int) error {
+	_ = unix.IoctlSetInt(fd, unix.TCFLSH, unix.TCIFLUSH)
+	return nil
+}
