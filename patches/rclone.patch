diff --git a/lib/buildinfo/osversion_haiku.go b/lib/buildinfo/osversion_haiku.go
new file mode 100644
index 0000000..d05f351
--- /dev/null
+++ b/lib/buildinfo/osversion_haiku.go
@@ -0,0 +1,16 @@
+//go:build haiku
+
+package buildinfo
+
+import "golang.org/x/sys/unix"
+
+// GetOSVersion returns OS version and kernel from uname
+func GetOSVersion() (osVersion, osKernel string) {
+	var u unix.Utsname
+	if err := unix.Uname(&u); err != nil {
+		return "", ""
+	}
+	osVersion = unix.ByteSliceToString(u.Sysname[:]) + " " + unix.ByteSliceToString(u.Release[:])
+	osKernel = unix.ByteSliceToString(u.Version[:]) + " (" + unix.ByteSliceToString(u.Machine[:]) + ")"
+	return osVersion, osKernel
+}
diff --git a/lib/diskusage/diskusage_haiku.go b/lib/diskusage/diskusage_haiku.go
new file mode 100644
index 0000000..96f6cc1
--- /dev/null
+++ b/lib/diskusage/diskusage_haiku.go
@@ -0,0 +1,27 @@
+//go:build haiku
+
+package diskusage
+
+import (
+	"golang.org/x/sys/unix"
+)
+
+// New returns the disk status for dir.
+//
+// May return Unsupported error if it doesn't work on this platform.
+func New(dir string) (info Info, err error) {
+	var statfs unix.Statvfs_t
+	err = unix.Statvfs(dir, &statfs)
+	if err != nil {
+		return info, err
+	}
+	// Note that these can be different sizes on different OSes so
+	// we upcast them all to uint64
+	//nolint:unconvert
+	info.Free = uint64(statfs.Bfree) * uint64(statfs.Bsize)
+	//nolint:unconvert
+	info.Available = uint64(statfs.Bavail) * uint64(statfs.Bsize)
+	//nolint:unconvert
+	info.Total = uint64(statfs.Blocks) * uint64(statfs.Bsize)
+	return info, nil
+}
