new file mode 100644
index 0000000..ae75ac8
--- /dev/null
+++ b/backend/local/about_haiku.go
@@ -0,0 +1,34 @@
+//go:build haiku
+
+package local
+
+import (
+	"context"
+	"fmt"
+	"os"
+
+	"github.com/rclone/rclone/fs"
+	"golang.org/x/sys/unix"
+)
+
+// About gets quota information
+func (f *Fs) About(ctx context.Context) (*fs.Usage, error) {
+	var s unix.Statvfs_t
+	err := unix.Statvfs(f.root, &s)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, fs.ErrorDirNotFound
+		}
+		return nil, fmt.Errorf("failed to read disk usage: %w", err)
+	}
+	bs := int64(s.Bsize)
+	usage := &fs.Usage{
+		Total: fs.NewUsageValue(bs * int64(s.Blocks)),
+		Used:  fs.NewUsageValue(bs * int64(s.Blocks-s.Bfree)),
+		Free:  fs.NewUsageValue(bs * int64(s.Bavail)),
+	}
+	return usage, nil
+}
+
+// check interface
+var _ fs.Abouter = &Fs{}
