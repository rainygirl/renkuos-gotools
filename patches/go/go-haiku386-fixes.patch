 func parseRuntimeDebugVars(godebug string) {
 	// defaults
+	if GOOS == "haiku" && GOARCH == "386" {
+		// Async preemption still crashes the 386 signal path (a hello world
+		// dies with SIGSEGV on hrev60450 under QEMU). Off by default;
+		// GODEBUG=asyncpreemptoff=0 turns it back on.
+		debug.asyncpreemptoff = 1
+	}
 	debug.cgocheck = 1
 	debug.invalidptr = 1
 	debug.adaptivestackstart = 1 // set this to 0 to turn larger initial goroutine stacks off
